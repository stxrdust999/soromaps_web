# URL base da API backend (dotnet). Em desenvolvimento local: http://localhost:5099
API_URL=http://localhost:5099

# URL base pública da aplicação web (usada para metadados, canonical e sitemaps)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo de autorização para acionamento de rotinas agendadas (Vercel Cron) - mínimo 16 caracteres
CRON_SECRET=

# Credenciais do Google Gemini para geração editorial de pautas
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
